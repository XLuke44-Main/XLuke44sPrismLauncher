<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>org.xluke44.Prismlauncher</id>
  <launchable type="desktop-id">org.xluke44.Prismlauncher.desktop</launchable>
  <name>XLuke44's Prismlauncher</name>
  <developer_name>XLuke44</developer_name>
  <summary>An independent Prism Launcher 8.4-based launcher fork maintained by XLuke44</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <url type="homepage">https://github.com/XLuke44-Main/XLuke44sPrismLauncher</url>
  <url type="help">https://github.com/XLuke44-Main/XLuke44sPrismLauncher</url>
  <url type="bugtracker">https://github.com/XLuke44-Main/XLuke44sPrismLauncher/issues</url>
  <url type="contact">https://github.com/XLuke44-Main/XLuke44sPrismLauncher</url>
  <url type="vcs-browser">https://github.com/XLuke44-Main/XLuke44sPrismLauncher</url>
  <url type="contribute">https://github.com/XLuke44-Main/XLuke44sPrismLauncher/blob/develop/CONTRIBUTING.md</url>
  <description>
    <p>XLuke44's Prismlauncher is an independent custom launcher based on Prism Launcher 8.4. It is not endorsed by or affiliated with Prism Launcher.</p>
    <p>This fork embeds its interface translations for English (United Kingdom) and Polish. English (United Kingdom) is the default and fallback language.</p>
    <p>Features:</p>
    <ul>
      <li>Easily install game modifications, such as Fabric, Forge and Quilt</li>
      <li>Easily install and update modpacks from the Launcher</li>
      <li>Control your Java settings, and enable Mangohud or Gamemode with a toggle</li>
      <li>Manage worlds and resource packs from the launcher</li>
      <li>See logs and other details easily through a dashboard</li>
      <li>Kill Minecraft in case of a crash/freeze</li>
      <li>Isolate Minecraft instances to keep everything clean</li>
      <li>Install and update mods directly from the launcher</li>
      <li>Customize the launcher with themes, and more</li>
      <li>And cat :3</li>
    </ul>
  </description>
<releases>
    <release version="@Launcher_VERSION_NAME@" date="@Launcher_BUILD_TIMESTAMP@"></release>
  </releases>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
</component>
